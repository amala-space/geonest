# Firebase web config — create your own Firebase project and paste its web app keys.
# These ship in the client bundle (not secret), but they bind the app to YOUR
# project. Never reuse another project's values. Access is enforced by
# firestore.rules + Firebase authorized domains, not by key secrecy.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Public deploy URL — used for canonical links, OG/social images, share links.
PUBLIC_APP_URL=http://localhost:5173

# Android build identity (only needed if you build the Capacitor APK). Precedence:
# -PandroidAppId/-PandroidDeepLinkHost/-PandroidDeepLinkPathPrefix > PUBLIC_ANDROID_* environment > root .env > neutral defaults.
# Use the same identity in google-services.json.
PUBLIC_ANDROID_APP_ID=com.example.geonest
# Android App Link filter. Use your deployment host and the join route it serves.
PUBLIC_ANDROID_DEEP_LINK_HOST=example.com
PUBLIC_ANDROID_DEEP_LINK_PATH_PREFIX=/geonest/join/
# Tester Group for Play closed testing, set to "anyone on the web can join".
# Empty hides the self-join steps in the early-access dialog.
PUBLIC_EARLY_ACCESS_GROUP_URL=
PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
