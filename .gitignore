.venv
.venv-docs
venv/
**/pyvenv.cfg

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test
# This build input must survive both local and global ignore rules in a fresh
# public repository (the Functions Vitest runner loads it directly).
!functions/tsconfig.json

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Local agent state
.claude/

# Android signing — never commit
/android/keystore.properties
/android/*.jks
/android/*.keystore

# Deep-link identity — package + signing fingerprint (use the .example)
/static/.well-known/assetlinks.json

# Build identity — env-overridable, copied from capacitor.config.ts.example
/capacitor.config.ts

/scripts/tutorials/.storage-state.json

# Local Google Play API service-account key used by the tester probe.
/play-service-account.json

/.firebaserc
/playwright.tutorials.config.ts

/.firebase/
