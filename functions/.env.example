# Comma-separated browser origins allowed to call submitFeedback in a deployed
# Firebase project. Replace with the exact HTTPS origins for this fork.
# Leave functions/.env absent when using only local Vite development defaults.
FEEDBACK_CORS_ORIGINS=https://your-deployment.example

# Number of right-most X-Forwarded-For entries written by proxies this
# deployment trusts. Feedback rate limiting reads the client IP from that
# position, so a caller-supplied header cannot mint a fresh quota bucket.
# Leave unset (1) when the callable is reached directly, as the Firebase client
# SDK does. Add one for each extra trusted hop in front of it — an external
# HTTPS load balancer, or a Firebase Hosting rewrite to the function.
FEEDBACK_TRUSTED_PROXY_DEPTH=1
