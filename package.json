{
	"name": "geonest",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent",
		"prebuild": "npm run i18n:compile",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run i18n:compile",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pretest": "npm run i18n:compile",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"sync": "npm run build && npx cap sync",
		"tutorial:record": "playwright test --config=playwright.tutorials.config.ts",
		"verify:clean-checkout": "bash scripts/verify-clean-checkout.sh"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.6.5",
		"@inlang/paraglide-js": "^2.18.1",
		"@inlang/plugin-message-format": "^4.4.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.3.1",
		"@types/geojson": "^7946.0.16",
		"@types/qrcode": "^1.5.6",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/ui": "^4.1.6",
		"fake-indexeddb": "^6.2.5",
		"google-auth-library": "^10.9.1",
		"jsdom": "^29.1.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@capacitor-firebase/authentication": "^8.2.0",
		"@capacitor/android": "^8.0.0",
		"@capacitor/app": "^8.1.0",
		"@capacitor/core": "^8.3.4",
		"@capacitor/device": "^8.0.2",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/geolocation": "^8.2.0",
		"@capacitor/motion": "^8.0.0",
		"@capacitor/status-bar": "^8.0.2",
		"@capgo/capacitor-firebase-crashlytics": "^8.0.2",
		"@mapbox/shp-write": "^0.4.3",
		"@turf/turf": "^7.3.5",
		"capacitor-screenshot": "^8.0.0",
		"driver.js": "^1.4.0",
		"firebase": "^12.13.0",
		"html2canvas": "^1.4.1",
		"idb": "^8.0.3",
		"jszip": "^3.10.1",
		"maplibre-gl": "^5.24.0",
		"pmtiles": "^4.4.1",
		"qrcode": "^1.5.4",
		"terra-draw": "^1.30.0",
		"terra-draw-maplibre-gl-adapter": "^1.4.0"
	}
}
